{
    "name": "rene-roscher/conditional-cache-laravel",
    "description": "Conditional caching for Laravel: only cache a value when it passes validation (Cache::rememberWhen and friends).",
    "keywords": [
        "laravel",
        "cache",
        "remember",
        "rememberWhen",
        "conditional",
        "validation",
        "macro"
    ],
    "homepage": "https://github.com/Rene-Roscher/conditional-cache-laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rene Roscher",
            "email": "roscher794@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Rene-Roscher/conditional-cache-laravel/issues",
        "source": "https://github.com/Rene-Roscher/conditional-cache-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.24|^12.0|^13.0",
        "illuminate/container": "^11.24|^12.0|^13.0",
        "illuminate/support": "^11.24|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.2|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ReneRoscher\\ConditionalCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReneRoscher\\ConditionalCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ReneRoscher\\ConditionalCache\\ConditionalCacheServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "check": [
            "@format --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
